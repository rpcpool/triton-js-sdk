{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "ignoreDeprecations": "6.0",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "ws"],
    "rootDir": ".",
    "outDir": "dist"
  },
  "include": ["src", "test", "types"],
  "exclude": ["dist", "node_modules"]
}
